# Auto normalize line endings
* text=auto

# Python
*.py text eol=lf
*.pyx text eol=lf
*.pyi text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# JSON
*.json text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Markdown
*.md text eol=lf

# CSV/TSV
*.csv text eol=lf
*.tsv text eol=lf

# Binary
*.pkl binary
*.pt binary
*.pth binary
*.pkl binary
